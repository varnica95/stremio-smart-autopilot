{
  "name": "stremio-smart-autopilot",
  "version": "1.0.0",
  "description": "Stremio addon that ranks authorized streams by real availability and quality, and picks the best subtitles automatically.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pino": "^9.6.0",
    "stremio-addon-sdk": "^1.6.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}

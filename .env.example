# ── Server ────────────────────────────────────────────────────────────────
PORT=7000
HOST=0.0.0.0
# The URL Stremio uses to reach this addon. Must be HTTPS when the addon is not on localhost
# (Stremio only installs remote addons over HTTPS).
PUBLIC_URL=http://127.0.0.1:7000
LOG_LEVEL=info
# SQLite file for caches and reliability history. Empty = in-memory only.
DATABASE_PATH=./data/autopilot.db

# ── Stream providers ──────────────────────────────────────────────────────
# Comma-separated: internet-archive, local-library, upstream
STREAM_PROVIDERS=internet-archive,local-library,upstream
PROVIDER_TIMEOUT_MS=6000

# Your own media: JSON file mapping IMDb ids to URLs (see examples/library.json)
# LIBRARY_FILE=./examples/library.json

# Other Stremio addons to read from and rank together. Only add sources you are authorized to use.
# UPSTREAM_ADDONS=[{"id":"mylib","name":"My Library Addon","url":"https://my-addon.example.com"}]

# ── Stream testing ────────────────────────────────────────────────────────
PROBE_ENABLED=true
PROBE_TIMEOUT_MS=2500
PROBE_MAX_STREAMS=6
PROBE_BYTES=262144

# ── Cache lifetimes (seconds) ─────────────────────────────────────────────
DISCOVERY_CACHE_TTL_S=1800
HEALTH_CACHE_TTL_S=600
METADATA_CACHE_TTL_S=86400
SUBTITLE_CACHE_TTL_S=21600
# How fast old failures are forgiven (hours until a failure counts half as much)
RELIABILITY_HALF_LIFE_H=6

# ── Subtitles (OpenSubtitles.com REST API) ────────────────────────────────
# Create a free API consumer at https://www.opensubtitles.com/consumers
# OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=SmartAutoPilot v1.0.0
# Optional: logging in raises your daily download quota
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# Optional: enables the "original language" subtitle preference
# TMDB_API_KEY=

# ── Companion (automatic fallback for HTTP streams) ───────────────────────
# Only useful when this addon runs on the same machine or LAN as Stremio.
COMPANION_ENABLED=false
COMPANION_SESSION_TTL_H=6

# ── Defaults for users who have not configured the addon ─────────────────
# DEFAULT_PREFERENCES={"subtitleLanguages":["hr","en","original"],"preferredResolution":"1080p"}
